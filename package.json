{
  "name": "schulte-game",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run dev -w @schulte/client",
    "dev:phone": "npm run dev:phone -w @schulte/client",
    "build": "npm run build -w @schulte/client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
